{
  "TCP": {
    "443": {
      "HTTPS": true
    },
    "1433": {
      "TCPForward": "mssql:1433"
    }
  },
  "Web": {
    "${TS_CERT_DOMAIN}:443": {
      "Handlers": {
        "/": {
          "Proxy": "http://app:8080"
        }
      }
    }
  },
  "AllowFunnel": {
    "${TS_CERT_DOMAIN}:443": true
  }
}
