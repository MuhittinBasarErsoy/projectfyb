# docker compose bu dosyayı otomatik okur. Üretimde tüm değerleri değiştirin.

# SQL Server sa şifresi (en az 8 karakter; büyük/küçük harf, rakam, sembol). ";" kullanmayın.
MSSQL_SA_PASSWORD=FyBlue_Dev_Passw0rd!

# JWT imza anahtarı (en az 32 karakter). Üretmek için: openssl rand -base64 48
JWT_KEY=

# Hangfire paneli (/hangfire). Şifre boşsa panel kapalıdır.
HANGFIRE_USER=admin
HANGFIRE_PASSWORD=

# API dokümanı (/scalar/v1) üretimde kapalı kalmalı.
EXPOSE_API_DOCS=false

# ---- Tailscale ile yayın (docker-compose.tailscale.yml) ----
# Admin konsolu → Settings → Keys → Generate auth key (Reusable: kapalı, Ephemeral: kapalı).
TS_AUTHKEY=
# Tailnet'teki cihaz adı → https://fyblue.<tailnet>.ts.net
TS_HOSTNAME=fyblue
