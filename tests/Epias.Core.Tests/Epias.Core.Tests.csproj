<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xUnit1051: testler kısa sürelidir; yardımcı çağrılara ayrıca iptal
         belirteci taşımak okunabilirliği düşürmekten başka bir şey katmıyor. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.1.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Epias.Core\Epias.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\specs\electricity-swagger.json"
             Link="specs\electricity-swagger.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
