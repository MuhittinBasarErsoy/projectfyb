@inherits LayoutComponentBase

<div class="auth-shell">
    <section class="auth-hero" aria-hidden="true">
        <div class="auth-hero-inner">
            <span class="brand brand-light">
                <span class="brand-mark"><Icon Name="zap" Size="18" Stroke="2.2" /></span>
                <span class="brand-name">FyBlue</span>
            </span>
            <h2>Enerji verileriniz<br />tek panelde.</h2>
            <p>OSOS sayaç verileri ve EPİAŞ Şeffaflık Platformu tek hesapla, tek arayüzde.</p>
            <ul class="auth-points">
                <li><Icon Name="search" Size="16" /> OSOS tüketim, endeks ve profil sorguları</li>
                <li><Icon Name="layers" Size="16" /> 160+ EPİAŞ servisinin tekrarsız senkronizasyonu</li>
                <li><Icon Name="function" Size="16" /> Tablolar arası formüller ve zamanlanmış işler</li>
            </ul>
        </div>
    </section>
    <main class="auth-main">
        @Body
    </main>
</div>
